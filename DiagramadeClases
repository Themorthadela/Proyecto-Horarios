@startuml

' =====================
' CLASES
' =====================

class Usuario {
  ID_U : int
  Nombre : string
  Apellido : string
  Email : string
  Contraseña : string
  Activo : bool
  Rol : Enum
  
  Rol ('Admin', 'Director', 'Secretaria', 'Docente', 'Usuario')
}

class Docente {
  ID_D : int
  ID_U : int
  Grado : int (opcional)
  
  ID_U (FK) ID_U Usuario
}

class Materia {
  ID_M : int
  Nombre : string
  CargaHoraria : int
  HorasSe : int
  TipoSalon : enum 
  Activo : bool
  
  TipoSalon ('Laboratorio','Aula','Taller')
}

class Curso {
  ID_C : int
  Nombre : string
  CantidadHoras : int 
  Dias : int
  Semanal : int
  Activo : bool
  DuracionAnios : int
}

class Curso_Materia {
  ID_CM : int
  ID_C : int
  ID_M : int
  Anio : int
  Periodo : enum

  Periodo ('Anual', 'Semestre 1', 'Semestre 2')
}

class Turno {
  ID_H : int
  ID_C : int
  HoraEntrada : time
  HoraSalida : time
  Turno : enum 

  ID_C (FK) ID_C Curso
  Turno ('Matutino','Vespertino','Nocturno')
}

class HorarioFinal {
  ID_Hc : int
  ID_Am : int
  Año : date
  Dia : int
  HoraEntrada : time
  HoraSalida : time
  Disponible : bool

  ID_Am (FK) ID_Am Asignacion_Materia
}

class Asignacion_Materia {
  ID_Am : int
  ID_C : int
  ID_D : int
  ID_M : int
  
  ID_C (FK) ID_C Curso
  ID_D (FK) ID_D Docente
  ID_M (FK) ID_M Materia
}

' =====================
' RESTRICCIONES
' =====================

class Restriccion_Docente {
  ID_Rd : int
  ID_D : int 
  Dia : int
  HoraEntrada : time
  HoraSalida : time

  ID_D (FK) ID_D Docente
}

class Restriccion_Curso {
  ID_Rc : int
  ID_C : int
  Dia : int
  HoraEntrada : time
  HoraSalida : time
  Disponible : bool
  
  ID_C (FK) ID_C Curso
}

' =====================
' UNION
' =====================

class Docente_Materia {
  ID_Dm : int
  ID_D : int
  ID_M : int

  ID_D (FK) ID_D Docente
  ID_M (FK) ID_M Materia
}


' =====================
' RELACIONES
' =====================

Curso "1" -- "*" Turno
Curso "1" -- "*" Restriccion_Curso
Curso "1" -- "*" Curso_Materia
Materia "1" -- "*" Curso_Materia

Docente "1" -- "*" Restriccion_Docente 
Docente -right-|>  Usuario

Asignacion_Materia "1" -right- "1" Docente
Asignacion_Materia "1" -left- "1" Curso 
Asignacion_Materia "1" -up- "1" Materia
Asignacion_Materia "1" -- "1" HorarioFinal

Docente_Materia .. Docente
Docente_Materia .. Materia

@enduml
